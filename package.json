{
  "name": "dsh-sessionflow",
  "version": "1.1.0",
  "description": "Cross-agent session continuity for DeepSeek Harness. Continue work from Codex, Claude Code, Grok, ZCode and other coding agents directly inside DSH.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "HarryHeYu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarryHeYu/dsh-sessionflow.git"
  },
  "homepage": "https://github.com/HarryHeYu/dsh-sessionflow#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sessionflow",
    "session-management",
    "mcp",
    "ai-agent",
    "developer-tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "check:peer-range": "node scripts/check-peer-range-live.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || >=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3 <0.2.0-0 || >=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-alpha.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3",
    "@types/node": "^22.10.0",
    "semver": "^7.6.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bugs": "https://github.com/HarryHeYu/dsh-sessionflow/issues"
}
